@model IEnumerable<practice1.Models.Movie.Movie>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a class="btn btn-success"asp-action="Create">Create New</a>
    <a class="btn btn-secondary"asp-action="AddOrEdit">AddOrEdit</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Title)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ReleaseDate)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Price)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Gener)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Title)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.ReleaseDate)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Price)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Gener)
            </td>
            <td>
                <a class="btn btn-primary"asp-action="Edit" asp-route-id="@item.ID">Edit</a> |
                <a class="btn btn-sm btn-info text-white"asp-action="Details" asp-route-id="@item.ID">Details</a> |
                <a class="btn btn-sm btn-danger" asp-action="Delete" asp-route-id="@item.ID">Delete</a> |
                <a class="btn btn-sm btn-outline-danger" asp-action="DeleteV2" asp-route-id="@item.ID" onclick="return confirm('是否確定刪除資料?')">DeleteV2</a>
            </td>
        </tr>
}
    </tbody>
</table>
